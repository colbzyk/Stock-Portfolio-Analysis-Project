table _Measures
	lineageTag: b518d0bb-b201-4d7b-97aa-1cd8d72b5fdc

	measure 'Total Return' = ```
			
			
			VAR startDate =
			    CALCULATE(
			        MIN(Data_ohlc[date]),
			        ALLSELECTED('Date')
			    )
			    
			VAR endDate = MAX(Data_ohlc[date])
			
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = startDate
			    )
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = endDate
			    )
			
			RETURN IF(NOT ISBLANK(maxValue) && NOT ISBLANK(minValue),
			    DIVIDE(maxValue, minValue)-1)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: 132fced5-277c-4328-8aac-b94a4c89dae2

	measure 'YTD Return' =
			
			
			VAR curDate =
			    CALCULATE(
			        MAX(Data_ohlc[date]),
			        REMOVEFILTERS('Date')
			    )
			
			var curYear = YEAR(curDate)
			
			var minDate = CALCULATE(
			    MIN('Data_ohlc'[date]),
			    REMOVEFILTERS('Date'),
			    'Date'[Year] = curYear
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = minDate
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = curDate)
			
			RETURN DIVIDE(maxValue, minValue)-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: 6f55bff4-8e67-45e7-8558-8d674e22135a

	measure '1Year Return' =
			
			
			VAR curDate = MAX(Data_ohlc[date])
			
			var prevYearTarget = EDATE(curDate, -12)
			
			var prevYear = CALCULATE(
			    MIN(Data_ohlc[date]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] >= prevYearTarget,
			    Data_ohlc[date] <= curDate
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = prevYear
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = curDate
			)
			
			RETURN IF(NOT ISBLANK(maxValue) && NOT ISBLANK(minValue),
			    DIVIDE(maxValue, minValue)-1)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: a7913075-1bf1-4504-a8ae-562d71002d87

	measure '1Month Return' = ```
			
			
			 VAR curDate =
			    CALCULATE(
			        MAX('Date'[Date]),
			        REMOVEFILTERS('Date')
			    )
			
			var prevMonthTarget = EDATE(curDate, -1)
			
			var prevMonth = CALCULATE(
			    MIN('Date'[Date]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] >= prevMonthTarget
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = prevMonth
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = curDate
			)
			
			RETURN DIVIDE(maxValue, minValue)-1
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: 0b5035d1-3984-4df2-ac4d-b782c26eae38

	measure '3Month Return' =
			
			
			VAR curDate =
			    CALCULATE(
			        MAX('Date'[Date]),
			        REMOVEFILTERS('Date')
			    )
			
			var prevMonthsTarget = EDATE(curDate, -3)
			
			var prevMonths = CALCULATE(
			    MIN('Date'[Date]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] >= prevMonthsTarget
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = prevMonths
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    'Date'[Date] = curDate
			)
			
			RETURN DIVIDE(maxValue, minValue)-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: b15ad124-6697-46d1-98ce-da2effddb53d

