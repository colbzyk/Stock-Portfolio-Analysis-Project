	measure 'Annualized Volatility' =
			
			STDEVX.S(
			    VALUES(Data_ohlc[date]),
			    CALCULATE(AVERAGE(Data_ohlc[daily_return]))
			) * SQRT(252)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Random
		lineageTag: a37ba103-1876-4841-a598-8e5d9a10039d

	measure 'Annualized Return' =
			
			var years = DIVIDE([Holding days], 365.25)
			
			RETURN (1 + [Total Return])^(1/years)-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Random
		lineageTag: 7ca6a69f-0a6f-409d-85fb-0a25a278b556

	measure 'Benchmark Annualized Return' = CALCULATE([Annualized Return], Tickers[Type] = "Benchmark")
		displayFolder: Benchmark Returns
		lineageTag: 5e10b9fa-37a3-4416-aef8-16869854151e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Benchmark Annualized Volatility' = CALCULATE([Annualized Volatility], Tickers[Type] = "Benchmark")
