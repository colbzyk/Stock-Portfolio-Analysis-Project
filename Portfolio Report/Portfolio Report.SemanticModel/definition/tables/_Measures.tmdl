	measure Peak =
			
			var curDate = MAX('Date'[Date])
			
			RETURN
			    MAXX(
			        FILTER(
			            ALLSELECTED('Date'[Date]),
			            'Date'[Date] <= curDate
			        ),
			        1 + [Total Return]
			    )
		displayFolder: Random
		lineageTag: f5bda671-9266-4152-b881-71a80632ed5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Drawdown = ```
			
			DIVIDE(
			    1 + [Total Return],
			    [Peak]
			) - 1
			
			```
		displayFolder: Random
		lineageTag: 539894f9-eb0a-4ff1-87c9-8817b2aaf176

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Portfolio Drawdown' =
			
			VAR curDate = MAX('Date'[Date])
			VAR curReturn = [Portfolio Total Return]
			VAR peakReturn =
			    MAXX(
			        FILTER(
			            ALLSELECTED('Date'[Date]),
			            'Date'[Date] <= curDate
			        ),
			        CALCULATE([Portfolio Total Return])
			    )
			RETURN
			    DIVIDE(
			        1 + curReturn,
			        1 + peakReturn
			    ) - 1
		displayFolder: Portfolio
		lineageTag: 59fb2a7d-0bb5-4455-a3e1-cc55572d5a4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Benchmark Drawdown' = ```
			
			VAR curDate = MAX('Date'[Date])
			VAR curReturn = [Total Return]
			VAR peakReturn =
			    MAXX(
			        FILTER(
			            ALLSELECTED('Date'[Date]),
			            'Date'[Date] <= curDate
			        ),
			        CALCULATE([Total Return])
			    )
			RETURN
			    DIVIDE(
			        1 + curReturn,
			        1 + peakReturn
			    ) - 1
			
			```
		displayFolder: Benchmark Returns
		lineageTag: 4b2c6512-c81e-4339-82a5-e36d2e384d66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2Year Return' =
			
			
			VAR curDate = MAX(Data_ohlc[date])
			
			var prevYearTarget = EDATE(curDate, -24)
			
			var prevYear = CALCULATE(
			    MIN(Data_ohlc[date]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] >= prevYearTarget,
			    Data_ohlc[date] <= curDate
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = prevYear
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = curDate
			)
			
			RETURN IF(NOT ISBLANK(maxValue) && NOT ISBLANK(minValue),
			    DIVIDE(maxValue, minValue)-1)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: 7ff6759a-104b-46bc-b09e-7045dbb4615b

	measure '3Year Return' =
			
			
			VAR curDate = MAX(Data_ohlc[date])
			
			var prevYearTarget = EDATE(curDate, -36)
			
			var prevYear = CALCULATE(
			    MIN(Data_ohlc[date]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] >= prevYearTarget,
			    Data_ohlc[date] <= curDate
			)
			
			var minValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = prevYear
			)
			
			var maxValue = CALCULATE(
			    MAX(Data_ohlc[close]),
			    REMOVEFILTERS('Date'),
			    Data_ohlc[date] = curDate
			)
			
			RETURN IF(NOT ISBLANK(maxValue) && NOT ISBLANK(minValue),
			    DIVIDE(maxValue, minValue)-1)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ticker Returns
		lineageTag: 6d8d8cf9-84ef-4a15-a08e-538866c35034

	measure 'Comparison Color YTD' =
			
			VAR benchmark_value = CALCULATE([YTD Return], REMOVEFILTERS(Tickers), Tickers[Type] = "Benchmark")
			
			RETURN
			SWITCH(
			    TRUE(),
			    [YTD Return] >= benchmark_value, "#118DFF",
			    [YTD Return] < benchmark_value, "#D64550"
