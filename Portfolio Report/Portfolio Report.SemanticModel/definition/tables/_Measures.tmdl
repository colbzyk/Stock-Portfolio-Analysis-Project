	measure 'Percentage Point Difference' =
			
			var num = ([Portfolio Total Return] - [Benchmark Total Return]) * 100
			
			// RETURN IF(num >= 0, "+" & FORMAT(num, "0.00"), "-" & FORMAT(num, "0.00"))
			RETURN num
		displayFolder: Random
