	measure 'Outperforming Stock Count' =
			
			var benchmark = [Benchmark Total Return]
			
			var _count = COUNTX(
			    FILTER(
			        VALUES(Tickers[ticker]),
			        [Portfolio Total Return] > benchmark
			    ),
			    1
			)
			RETURN (_count & " Stocks Outperformed The Benchmark Of " & FORMAT([Benchmark Total Return], "0.0000")*100 & "%")
		displayFolder: Random
		lineageTag: a6ea8280-7bfd-4719-aeb6-02fd022b04d1

	measure 'Stock Percentage of Total Return' =
			
			
			var sumOfReturns = SUMX(
			    CALCULATETABLE(Tickers, Tickers[Type] = "Stock"),
			    [Total Return]
			)
			
			var PercentageOfReturns = SUMX(
			    CALCULATETABLE(Tickers, Tickers[Type] = "Stock"),
			    DIVIDE([Total Return], sumOfReturns)
			)
			RETURN PercentageOfReturns
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Random
		lineageTag: 382286f4-d7bc-448f-b7d6-efc2ef5972d8

	measure 'Avg Of Top 3 Tickers' = ```
			
			var stockTickers = FILTER(ALLSELECTED(Tickers), CALCULATE(SELECTEDVALUE(Tickers[Type])) = "Stock")
			
			var top3 = TOPN(3, stockTickers, [Portfolio Total Return], DESC)
			
			RETURN AVERAGEX(top3, [Portfolio Total Return])
			
