			SWITCH(
			    TRUE(),
			    [3Year Return] >= benchmark_value, "#118DFF",
			    [3Year Return] < benchmark_value, "#D64550"
			)
		displayFolder: Colors
		lineageTag: d14ffa77-0ce4-4668-b597-46fcd72bf21a

	measure 'Portfolio label' = "Portfolio"
		displayFolder: Portfolio
		lineageTag: 3451377e-9d48-4138-a4fb-ba82cea1f172

	measure 'Portfolio 2Year Return' =
			CALCULATE(
			    AVERAGEX(
			    VALUES(Tickers[ticker]),
			    [2Year Return]),
			    Tickers[Type] = "Stock"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Portfolio
		lineageTag: 921f11ef-157b-406e-8d0f-881f25d082c1

	measure 'Portfolio 3Year Return' =
			CALCULATE(
			    AVERAGEX(
			    VALUES(Tickers[ticker]),
			    [3Year Return]),
			    Tickers[Type] = "Stock"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Portfolio
		lineageTag: 5fb0459b-ac85-4704-9783-302688d1b445

	measure 'Benchmark 2Year Return' =
			CALCULATE(
			    AVERAGEX(
			    VALUES(Tickers[ticker]),
			    [2Year Return]),
			    Tickers[Type] = "Benchmark"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Benchmark Returns
		lineageTag: 6e54c1da-22cc-4bb8-be12-4261d9ab788b

	measure 'Benchmark 3Year Return' =
			CALCULATE(
			    AVERAGEX(
			    VALUES(Tickers[ticker]),
			    [3Year Return]),
			    Tickers[Type] = "Benchmark"
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Benchmark Returns
		lineageTag: 90cba1e7-21bb-4153-a8b9-363156e3bf04

	measure 'Benchmark label' = "Benchmark"
		displayFolder: Benchmark Returns
		lineageTag: 832aabef-ca9b-4def-a344-fcd6742940d7

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

