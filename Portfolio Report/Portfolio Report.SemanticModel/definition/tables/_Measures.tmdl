	measure 'Top 2 Percentage of total gain' =
			
			var stockTickers = FILTER(ALLSELECTED(Tickers), CALCULATE(SELECTEDVALUE(Tickers[Type])) = "Stock")
			
			var top2 = TOPN(2, stockTickers, [Portfolio Total Return], DESC)
			
			var sumOfTop2Stock = SUMX(top2, [Total Return])
			var sumOfStock = SUMX(stockTickers, [Total Return])
			
			RETURN DIVIDE(sumOfTop2Stock,sumOfStock)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Random
		lineageTag: ff242dc5-90be-4316-b843-42128bd9ad4d

	measure 'Portfolio Volatility' = ```
			
			var stockTickers = FILTER(ALLSELECTED(Tickers), CALCULATE(SELECTEDVALUE(Tickers[Type])) = "Stock")
			
			var portfolioDailyReturns = 
			    ADDCOLUMNS(
			        VALUES('Date'[Date]),
			        "@PortfolioReturn",
			            var currentDate = 'Date'[Date]
			            RETURN
			                AVERAGEX(
			                    stockTickers,
			                    CALCULATE(
			                        AVERAGE(Data_ohlc[daily_return]),
			                        'Date'[Date] = currentDate
			                    )
			                )
			    )
			
			RETURN 
			    STDEVX.S(
			        portfolioDailyReturns,
			        [@PortfolioReturn]
			    ) * SQRT(252)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Portfolio
		lineageTag: c5057154-0988-4f59-afa1-1ea0b43a38f5

	measure 'Avg Holding Volatility' =
			
			var stockTickers = FILTER(Tickers, CALCULATE(SELECTEDVALUE(Tickers[Type])) = "Stock")
			
			RETURN AVERAGEX(stockTickers, [Annualized Volatility])
		formatString: 0.00%;-0.00%;0.00%
