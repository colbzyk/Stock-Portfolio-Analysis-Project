	measure 'Avg Without Top 2 Tickers' =
			
			var stockTickers = FILTER(ALLSELECTED(Tickers), CALCULATE(SELECTEDVALUE(Tickers[Type])) = "Stock")
			
			var numOfTickers = COUNTROWS(stockTickers)
			
			var topTickerswithout2 = TOPN(numOfTickers-2, stockTickers, [Portfolio Total Return], ASC)
			
			RETURN AVERAGEX(topTickerswithout2, [Portfolio Total Return])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Random Card Measures
		lineageTag: 8560684e-fe3c-42ac-bb12-043509dbc534

